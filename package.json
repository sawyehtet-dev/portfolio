{
    "name": "sawyehtet-com",
    "version": "3.0.0",
    "description": "Personal site of Saw Ye Htet: an editorial portfolio built with React, TypeScript, and Vite.",
    "type": "module",
    "main": "index.html",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && npm run generate:sitemap && vite build && npm run build:ssr && npm run prerender",
        "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
        "prerender": "node scripts/prerender.mjs",
        "generate:sitemap": "node scripts/generate-sitemap.mjs",
        "preview": "vite preview",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --config vitest.config.js",
        "test:watch": "vitest --config vitest.config.js",
        "validate": "npm run audit && npm run lint && npm run typecheck && npm run test",
        "audit": "node scripts/audit-ci.mjs",
        "generate:og": "node scripts/generate-og.mjs"
    },
    "author": "Saw Ye Htet <sawyehtet.dev@gmail.com>",
    "license": "MIT",
    "devDependencies": {
        "@axe-core/react": "^4.12.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.62.0",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^10.8.1",
        "eslint-plugin-security": "^4.0.1",
        "jsdom": "^29.0.2",
        "prettier": "^3.9.6",
        "puppeteer": "^25.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sawyehtet-dev/portfolio.git"
    },
    "homepage": "https://sawyehtet.com",
    "bugs": {
        "url": "https://github.com/sawyehtet-dev/portfolio/issues"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.2"
    }
}
